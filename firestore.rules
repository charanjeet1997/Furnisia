rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user's rooms live at users/{uid}/rooms/{roomId}. Only the signed-in owner
    // may read or write their own private subcollection.
    match /users/{userId}/rooms/{roomId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public shared rooms collection — allows anyone with a VR link or VR headset
    // to view the 3D room design without needing to log in.
    match /sharedRooms/{roomId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
